generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Acces {
  MEMBRE
  ADMIN
}

/// Accès d'un membre à l'espace participant : en attente après l'inscription,
/// actif une fois validé par l'équipe (plus tard : par le paiement), ou refusé.
enum StatutCompte {
  EN_ATTENTE
  ACTIF
  REFUSE
}

model User {
  id                    Int                          @id @default(autoincrement())
  email                 String                       @unique
  passwordHash          String                       @map("password_hash")
  firstName             String                       @map("first_name")
  lastName              String                       @map("last_name")
  role                  String?
  acces                 Acces                        @default(MEMBRE)
  /// Super admin promu depuis la plateforme ; les adresses de SUPER_ADMINS le sont d'office et restent intouchables.
  superAdmin            Boolean                      @default(false) @map("super_admin")
  statut                StatutCompte                 @default(EN_ATTENTE)
  decisionLe            DateTime?                    @map("decision_le")
  company               String?
  sector                String?
  bio                   String?                      @db.VarChar(600)
  phone                 String?
  website               String?
  city                  String?
  country               String?
  billetPaye            Boolean                      @default(false) @map("billet_paye")
  /// Paiement du billet par Vanilla Pay : date du règlement et référence du paiement qui a ouvert l'accès.
  payeLe                DateTime?                    @map("paye_le")
  paiementReference     String?                      @map("paiement_reference") @db.VarChar(20)
  /// Code du billet (QR), tiré au hasard par la base à la création du compte : impossible à deviner.
  codeBillet            String                       @unique @default(dbgenerated("('TRV26-'::text || upper(substr(md5(((random())::text || (clock_timestamp())::text)), 1, 8)))")) @map("code_billet") @db.VarChar(20)
  /// Photo de profil : adresse /api/profil/photos/<id>, fichier dans stockage/profils.
  photo                 String?                      @db.VarChar(200)
  /// Photo de couverture (bannière du profil et de la fiche annuaire), rangée comme la photo de profil.
  couverture            String?                      @db.VarChar(200)
  /// Cadrage vertical de la couverture, en pourcentage (0 : haut de l'image, 100 : bas), réglé par le participant.
  couverturePosition    Int                          @default(50) @map("couverture_position")
  /// Identifiants des comptes Google et Facebook reliés (connexion et inscription en un clic).
  googleId              String?                      @unique @map("google_id")
  facebookId            String?                      @unique @map("facebook_id")
  createdAt             DateTime                     @default(now()) @map("created_at")
  updatedAt             DateTime                     @updatedAt @map("updated_at")
  sessions              Session[]
  publications          Publication[]
  jaimesFil             JaimeFil[]
  commentairesFil       CommentaireFil[]
  inscriptionsProgramme InscriptionProgramme[]
  reinitialisations     ReinitialisationMotDePasse[]
  conversations         ParticipantConversation[]
  messages              Message[]
  annonces              Annonce[]
  annoncesVues          AnnonceVue[]
  rdvDemandes           RendezVousB2B[]              @relation("rdvDemandeur")
  rdvRecus              RendezVousB2B[]              @relation("rdvDestinataire")
  participationsDefis   ParticipationDefi[]
  photosGalerie         PhotoGalerie[]
  stories               Story[]
  souvenirsLivre        SouvenirLivre[]
  parcoursAccueil       ParcoursAccueil?
  entreeGala            EntreeGala?                  @relation("entreeParticipant")
  paiements             Paiement[]
  entreesScannees       EntreeGala[]                 @relation("entreeScanneur")

  @@map("users")
}

model Session {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique @map("token_hash")
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("sessions")
}

enum CategorieRessource {
  guide
  modele
  formation
  rapport
}

enum FormatRessource {
  pdf
  docx
  video
  photo
  page
}

model Dossier {
  id          String   @id @default(cuid())
  nom         String
  couverture  String?
  auteurNom   String?  @map("auteur_nom")
  auteurRole  String?  @map("auteur_role")
  auteurBio   String?  @map("auteur_bio")
  auteurPhoto String?  @map("auteur_photo")
  parentId    String?  @map("parent_id")
  ordre       Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  parent     Dossier?    @relation("Arborescence", fields: [parentId], references: [id], onDelete: Restrict)
  enfants    Dossier[]   @relation("Arborescence")
  ressources Ressource[]

  @@index([parentId])
  @@map("dossiers")
}

model Ressource {
  id              String             @id @default(cuid())
  titre           String
  categorie       CategorieRessource @default(guide)
  format          FormatRessource
  taille          String?
  tailleOctets    BigInt?            @map("taille_octets")
  date            DateTime           @default(now())
  fichier         String?
  pages           Int                @default(0)
  couverture      String?
  couverturePerso Boolean            @default(false) @map("couverture_perso")
  description     String?            @db.VarChar(600)
  contenu         Json?
  ordre           Int                @default(0)
  dossierId       String?            @map("dossier_id")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  dossier  Dossier?           @relation(fields: [dossierId], references: [id], onDelete: SetNull)
  lectures LectureRessource[]

  @@index([dossierId, ordre])
  @@map("ressources")
}

model LectureRessource {
  id          String   @id @default(cuid())
  lecteur     String
  ressourceId String   @map("ressource_id")
  date        DateTime @default(now())

  ressource Ressource @relation(fields: [ressourceId], references: [id], onDelete: Cascade)

  @@unique([lecteur, ressourceId])
  @@map("lectures_ressources")
}

model Journal {
  id        String   @id @default(cuid())
  acteur    String
  action    String
  details   String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("journal")
}

/// Publication du fil d'actualité : par un participant, ou au nom de l'équipe (equipe, réservé aux administrateurs).
model Publication {
  id       String   @id @default(cuid())
  auteurId Int      @map("auteur_id")
  auteur   User     @relation(fields: [auteurId], references: [id], onDelete: Cascade)
  equipe   Boolean  @default(false)
  texte    String   @default("") @db.VarChar(1200)
  image    String?
  video    String?
  creeLe   DateTime @default(now()) @map("cree_le")

  @@index([creeLe])
  @@map("publications")
}

/// J'aime du fil. cible : "pub:<id>" (publication) ou "actu:<id>" (article officiel, liste ACTUS).
model JaimeFil {
  cible  String
  userId Int      @map("user_id")
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  creeLe DateTime @default(now()) @map("cree_le")

  @@id([cible, userId])
  @@map("fil_jaimes")
}

/// Commentaire du fil, sur la même cible que les j'aime.
model CommentaireFil {
  id       String   @id @default(cuid())
  cible    String
  auteurId Int      @map("auteur_id")
  auteur   User     @relation(fields: [auteurId], references: [id], onDelete: Cascade)
  texte    String   @db.VarChar(1000)
  creeLe   DateTime @default(now()) @map("cree_le")

  @@index([cible, creeLe])
  @@map("fil_commentaires")
}

/// Rendez-vous du programme de la journée, géré depuis /admin/programme.
/// categorie : Expositions, Panels, Réseautage ou Gala (CATS) ; places à 0 = accès libre ; image : nom d'une photo de /public/traversee.
model RendezVousProgramme {
  id           String                 @id @default(cuid())
  titre        String                 @db.VarChar(160)
  categorie    String                 @db.VarChar(40)
  heure        String                 @db.VarChar(60)
  lieu         String                 @db.VarChar(160)
  places       Int                    @default(0)
  resume       String                 @db.VarChar(300)
  details      String                 @default("") @db.VarChar(4000)
  image        String                 @db.VarChar(40)
  ordre        Int                    @default(0)
  creeLe       DateTime               @default(now()) @map("cree_le")
  inscriptions InscriptionProgramme[]

  @@map("programme")
}

/// Inscription d'un participant à un rendez-vous du programme.
model InscriptionProgramme {
  rendezVousId String              @map("rendez_vous_id")
  rendezVous   RendezVousProgramme @relation(fields: [rendezVousId], references: [id], onDelete: Cascade)
  userId       Int                 @map("user_id")
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  creeLe       DateTime            @default(now()) @map("cree_le")

  @@id([rendezVousId, userId])
  @@index([userId])
  @@map("programme_inscriptions")
}

/// Lien « mot de passe oublié » envoyé par e-mail : seule l'empreinte SHA-256 du jeton est gardée ; valable 1 heure, une seule fois.
model ReinitialisationMotDePasse {
  id        Int       @id @default(autoincrement())
  tokenHash String    @unique @map("token_hash")
  userId    Int       @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime  @map("expires_at")
  utiliseLe DateTime? @map("utilise_le")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("reinitialisations_mot_de_passe")
}

/// Conversation de la messagerie : entre deux comptes (cle « u12-u34 »), ou entre un participant et l'équipe CanCham
/// (equipe = true, cle « equipe-u12 ») ; les administrateurs y répondent au nom de l'équipe.
model Conversation {
  id             String                    @id @default(cuid())
  cle            String                    @unique @db.VarChar(40)
  equipe         Boolean                   @default(false)
  /// Lecture côté équipe (conversation avec l'équipe) : messages du participant non lus après cette date.
  equipeLuLe     DateTime?                 @map("equipe_lu_le")
  dernierMessage DateTime                  @default(now()) @map("dernier_message")
  creeLe         DateTime                  @default(now()) @map("cree_le")
  participants   ParticipantConversation[]
  messages       Message[]

  @@index([equipe, dernierMessage])
  @@map("conversations")
}

/// Compte qui participe à une conversation ; luLe : messages des autres non lus après cette date.
model ParticipantConversation {
  conversationId String       @map("conversation_id")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         Int          @map("user_id")
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  luLe           DateTime?    @map("lu_le")

  @@id([conversationId, userId])
  @@index([userId])
  @@map("conversation_participants")
}

/// Message texte ou vocal (audio : /api/messages/audio/<id>, fichier dans stockage/messages).
model Message {
  id             String       @id @default(cuid())
  conversationId String       @map("conversation_id")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  auteurId       Int          @map("auteur_id")
  auteur         User         @relation(fields: [auteurId], references: [id], onDelete: Cascade)
  texte          String       @default("") @db.VarChar(4000)
  audio          String?      @db.VarChar(200)
  audioSecondes  Int?         @map("audio_secondes")
  creeLe         DateTime     @default(now()) @map("cree_le")

  @@index([conversationId, creeLe])
  @@map("messages")
}

/// Annonce de l'équipe aux participants : fenêtre à la prochaine page ouverte, puis dans la cloche.
/// type : info, programme ou urgent ; cta : page interne du bouton (DESTINATIONS) ; image : /api/fil/images/<id>.
model Annonce {
  id       String       @id @default(cuid())
  titre    String       @db.VarChar(120)
  message  String       @db.VarChar(1200)
  type     String       @default("info") @db.VarChar(20)
  cta      String       @default("") @db.VarChar(200)
  image    String?      @db.VarChar(200)
  auteurId Int?         @map("auteur_id")
  auteur   User?        @relation(fields: [auteurId], references: [id], onDelete: SetNull)
  creeLe   DateTime     @default(now()) @map("cree_le")
  vues     AnnonceVue[]

  @@index([creeLe])
  @@map("annonces")
}

/// Annonce vue par un participant (la fenêtre ne s'ouvre qu'une fois).
model AnnonceVue {
  annonceId String   @map("annonce_id")
  annonce   Annonce  @relation(fields: [annonceId], references: [id], onDelete: Cascade)
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vueLe     DateTime @default(now()) @map("vue_le")

  @@id([annonceId, userId])
  @@index([userId])
  @@map("annonces_vues")
}

/// Rendez-vous B2B du 18 décembre entre deux participants : creneau = indice dans CRENEAUX (20 minutes), lieu = indice dans LIEUX.
/// statut : ATTENTE (emplacement réservé 48 h, puis expiré), CONFIRME, DECLINE ou ANNULE. Chaque côté a sa note privée.
model RendezVousB2B {
  id               String    @id @default(cuid())
  demandeurId      Int       @map("demandeur_id")
  demandeur        User      @relation("rdvDemandeur", fields: [demandeurId], references: [id], onDelete: Cascade)
  destinataireId   Int       @map("destinataire_id")
  destinataire     User      @relation("rdvDestinataire", fields: [destinataireId], references: [id], onDelete: Cascade)
  creneau          Int
  lieu             Int
  statut           String    @default("ATTENTE") @db.VarChar(12)
  noteDemandeur    String    @default("") @map("note_demandeur") @db.VarChar(1000)
  noteDestinataire String    @default("") @map("note_destinataire") @db.VarChar(1000)
  creeLe           DateTime  @default(now()) @map("cree_le")
  decideLe         DateTime? @map("decide_le")

  @@index([creneau, lieu, statut])
  @@index([demandeurId])
  @@index([destinataireId])
  @@map("rendez_vous_b2b")
}

/// Participation à un défi, une par compte et par défi.
/// « pitch » : lien de la vidéo pitch et note du jury (sur 20) ; « tombola » : lien de la publication « J'y serai »,
/// dernier relevé des réactions Facebook (lu par le serveur), et retrait éventuel du classement par l'équipe.
model ParticipationDefi {
  id           String    @id @default(cuid())
  defi         String    @db.VarChar(12)
  userId       Int       @map("user_id")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lien         String    @db.VarChar(500)
  reactions    Int?
  commentaires Int?
  partages     Int?
  releveLe     DateTime? @map("releve_le")
  note         Float?
  avis         String    @default("") @db.VarChar(1000)
  noteLe       DateTime? @map("note_le")
  retire       Boolean   @default(false)
  creeLe       DateTime  @default(now()) @map("cree_le")
  majLe        DateTime  @updatedAt @map("maj_le")

  @@unique([defi, userId])
  @@index([defi])
  @@map("participations_defis")
}

/// Photo de la galerie de l'événement : le fichier est dans stockage/photos/<id>.<format>.
model PhotoGalerie {
  id         String   @id @db.VarChar(32)
  auteurId   Int?     @map("auteur_id")
  auteur     User?    @relation(fields: [auteurId], references: [id], onDelete: SetNull)
  /// Prise par l'équipe CanCham (sinon partagée par un participant).
  officielle Boolean  @default(true)
  creeLe     DateTime @default(now()) @map("cree_le")

  @@index([creeLe])
  @@map("photos_galerie")
}

/// Story de la CanCham en haut de l'accueil.
model Story {
  id       String   @id @default(cuid())
  /// /api/fil/images/<id> (photo envoyée) ou photo du site (/traversee/…).
  image    String   @db.VarChar(300)
  texte    String   @default("") @db.VarChar(300)
  auteurId Int?     @map("auteur_id")
  auteur   User?    @relation(fields: [auteurId], references: [id], onDelete: SetNull)
  creeLe   DateTime @default(now()) @map("cree_le")

  @@index([creeLe])
  @@map("stories")
}

/// Emplacement promotion de l'accueil (0 à 3), rempli par l'équipe.
model Promotion {
  emplacement Int      @id
  annonceur   String   @db.VarChar(80)
  titre       String   @db.VarChar(60)
  texte       String   @default("") @db.VarChar(90)
  image       String   @db.VarChar(300)
  lien        String   @db.VarChar(200)
  majLe       DateTime @updatedAt @map("maj_le")

  @@map("promotions")
}

/// Page du livre d'or vidéo : publiée après validation par l'équipe.
model SouvenirLivre {
  id       String    @id @default(cuid())
  auteurId Int       @map("auteur_id")
  auteur   User      @relation(fields: [auteurId], references: [id], onDelete: Cascade)
  /// /api/videos/<id>
  video    String    @db.VarChar(300)
  /// Durée relevée par le navigateur, en secondes.
  duree    Int?
  /// Message du participant, retouchable par l'équipe.
  texte    String    @default("") @db.VarChar(1000)
  /// ATTENTE, VALIDE ou REFUSE
  statut   String    @default("ATTENTE") @db.VarChar(10)
  creeLe   DateTime  @default(now()) @map("cree_le")
  decideLe DateTime? @map("decide_le")

  @@index([statut, creeLe])
  @@index([auteurId])
  @@map("livre_or")
}

/// Entrée au gala : une par participant, enregistrée par le scanner du back-office.
model EntreeGala {
  userId      Int      @id @map("user_id")
  user        User     @relation("entreeParticipant", fields: [userId], references: [id], onDelete: Cascade)
  scanneLe    DateTime @default(now()) @map("scanne_le")
  scanneParId Int?     @map("scanne_par_id")
  scannePar   User?    @relation("entreeScanneur", fields: [scanneParId], references: [id], onDelete: SetNull)

  @@index([scanneLe])
  @@map("entrees_gala")
}

/// Parcours d'accueil après l'inscription : étapes passées (photo, entreprise, pitch, tombola) et fin du parcours.
/// Une étape faite se lit dans les données du compte ; seules les étapes passées sont gardées ici.
model ParcoursAccueil {
  userId     Int       @id @map("user_id")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  passees    String[]  @default([])
  commenceLe DateTime  @default(now()) @map("commence_le")
  termineLe  DateTime? @map("termine_le")
  majLe      DateTime  @updatedAt @map("maj_le")

  @@map("parcours_accueil")
}

/// Échec de connexion, par adresse e-mail (« email:… ») et par adresse IP (« ip:… ») : limite les tentatives sur un mot de passe.
model TentativeConnexion {
  id     Int      @id @default(autoincrement())
  cle    String   @db.VarChar(200)
  creeLe DateTime @default(now()) @map("cree_le")

  @@index([cle, creeLe])
  @@map("tentatives_connexion")
}

/// Tentative de paiement du billet chez Vanilla Pay : une référence propre à la plateforme (LT-2026-XXXXXX),
/// le moyen choisi, l'identifiant de transaction Vanilla Pay et la notification brute reçue.
model Paiement {
  id           String    @id @default(cuid())
  reference    String    @unique @db.VarChar(20)
  userId       Int       @map("user_id")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Montant en ariary, entier.
  montant      Int
  devise       String    @default("MGA") @db.VarChar(3)
  /// carte | mvola | orange_money | airtel_money
  mode         String    @db.VarChar(20)
  /// en_cours | reussi | echoue
  statut       String    @default("en_cours") @db.VarChar(10)
  /// Identifiant de la transaction chez Vanilla Pay (VPI… pour la carte, MM… pour le mobile money).
  transaction  String?   @db.VarChar(120)
  notification Json?
  regleLe      DateTime? @map("regle_le")
  creeLe       DateTime  @default(now()) @map("cree_le")
  majLe        DateTime  @updatedAt @map("maj_le")

  @@index([userId, statut])
  @@index([transaction])
  @@map("paiements")
}
