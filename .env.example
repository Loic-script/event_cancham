# Connexion PostgreSQL locale (PostgreSQL 17 installé sur cette machine, port 5432)
# Format : postgresql://UTILISATEUR:MOT_DE_PASSE@HOTE:PORT/BASE?schema=public
DATABASE_URL="postgresql://postgres:VOTRE_MOT_DE_PASSE@localhost:5432/event_db?schema=public"

# Vérification des publications Facebook et Instagram (facultatif, voir README « Liaison avec Facebook et Instagram »)
# À créer sur https://developers.facebook.com/apps : identifiant et clé secrète de l'application Meta.
# Sans ces deux valeurs, les liens sont vérifiés sur leur forme et la publication s'affiche en aperçu,
# et le relevé automatique des réactions (défi 3 000 000 Ar) reste indisponible.
META_APP_ID=""
META_APP_SECRET=""
META_GRAPH_VERSION="v23.0"
# Connexion Facebook des participants (relevé réel des réactions). Dans l'app Meta : Facebook Login › URI de redirection OAuth valides.
# Par défaut : <origine du site>/api/facebook/callback, par exemple http://localhost:3000/api/facebook/callback
META_REDIRECT_URI=""

# Application Meta Business (prioritaire sur META_APP_ID / META_APP_SECRET si renseignée)
META_BUSINESS_APP_ID=""
META_BUSINESS_APP_SECRET=""
# Autorisations demandées à la connexion Facebook (une app Business n'a pas user_posts : laisser public_profile)
META_SCOPES="public_profile"

# Bibliothèque de ressources (facultatif, voir README « Bibliothèque de ressources »)
# Dossier des fichiers convertis, hors de public/ (défaut : ./stockage)
STOCKAGE_DIR=""
# Chemin de pdftoppm (Poppler). Sans lui, les PDF sont convertis avec pdf.js.
PDFTOPPM_PATH=""
# Chemin de LibreOffice (soffice) pour convertir les DOCX en PDF. Sans lui, les DOCX sont refusés.
SOFFICE_PATH=""

# Adresse publique du site, sans « / » final (obligatoire en production pour « Mot de passe oublié »).
# Sert aux liens envoyés par e-mail et aux adresses de retour de Google et Facebook.
APP_URL=""

# Envoi d'e-mails « Mot de passe oublié » par Resend (https://resend.com/api-keys).
# L'expéditeur doit appartenir à un domaine vérifié dans Resend (Domains). Les réponses vont à COURRIEL_EQUIPE.
# Sans RESEND_API_KEY en développement, le lien est écrit dans le terminal du serveur au lieu d'être envoyé.
RESEND_API_KEY=""
COURRIEL_EXPEDITEUR="Impact 261 <noreply@info.cancham.mg>"
COURRIEL_EQUIPE="info@cancham.mg"

# Connexion et inscription avec Google (https://console.cloud.google.com/apis/credentials, « ID client OAuth », application Web).
# URI de redirection autorisée : <APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Connexion et inscription avec Facebook (à défaut : META_APP_ID / META_APP_SECRET).
# Dans l'app Meta : Facebook Login › URI de redirection OAuth valides : <APP_URL>/api/auth/facebook/callback ; autorisation « email ».
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""

# Paiement du billet par Vanilla Pay (carte bancaire, MVola, Orange Money, Airtel Money). Identifiants fournis par Vanilla Pay
# dans le back-office marchand ; VANILLAPAY_KEY_SECRET signe les notifications. Clés côté serveur seulement, jamais journalisées.
# Sans ces trois valeurs, /paiement affiche « pas encore activé ». Prix du billet en ariary (entier, 5 000 au moins).
# À déclarer chez Vanilla Pay : notification <APP_URL>/api/paiements/vanillapay, retour <APP_URL>/paiement/retour.
VANILLAPAY_CLIENT_ID=""
VANILLAPAY_CLIENT_SECRET=""
VANILLAPAY_KEY_SECRET=""
# Base de l'API (défaut : https://bo.vanilla-pay.net). En local, le simulateur : http://localhost:3000/simulateur-vanillapay
# (il faut alors renseigner trois clés quelconques ci-dessus, identiques pour le simulateur et l'application).
VANILLAPAY_BASE=""
PAIEMENT_MONTANT_AR="500000"

# Super admin : adresses séparées par des virgules. Lui seul ajoute des administrateurs, leur retire les droits ou supprime leur compte,
# et personne ne peut le modifier ni le supprimer depuis la plateforme. Au démarrage, son compte est créé (ou repris) avec un mot de passe
# inconnu : on y entre par « Mot de passe oublié », qui envoie le lien dans sa boîte.
SUPER_ADMINS="info@cancham.mg"

# Base des tests automatisés (npm test pour les tests qui touchent la base, npm run test:e2e pour Playwright) :
# une base à part, jamais celle de développement ; son nom doit contenir « test » ou « ci ». Sans cette variable, ces tests sont ignorés.
# Création : CREATE DATABASE event_test; puis DATABASE_URL="<cette adresse>" npx prisma migrate deploy
DATABASE_URL_TEST="postgresql://postgres:motdepasse@localhost:5432/event_test?schema=public"
